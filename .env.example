# ---------------------------------------------------------------- database
# Left as-is, docker compose points this at the bundled mongo service.
# For MongoDB Atlas, paste the connection string here instead.
MONGO_URL=mongodb://mongo:27017
DB_NAME=aptimizer

# ---------------------------------------------------------------- security
# Sign-in tokens are signed with this. Generate a fresh one, never reuse an
# example, and never commit the real file:
#   openssl rand -hex 32
JWT_SECRET=

# Created on first startup. Change the password after the first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------- web
# Only used when the API is served from a different origin than the web app.
# With this compose file they share an origin, so it can stay as-is.
FRONTEND_URL=http://localhost

# Host port the web app is published on. 80 for a server, 8080 if something
# already occupies 80 on your Mac.
WEB_PORT=80

# ---------------------------------------------------------------- HTTPS
# Only needed if you uncomment the caddy service.
DOMAIN=aptimizer.example.com
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------- AI
# At least one is required for APT and the AI reports. Without any, those
# features disable themselves with a reason rather than erroring.
GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# EMERGENT_LLM_KEY=

# ---------------------------------------------------------------- code retrieval
# Clause retrieval over your own licensed copies of the IS/NBC text. Nothing is
# downloaded and nothing is committed; you place the text yourself. With no corpus
# on disk the feature reports itself unavailable with a reason and the rest of the
# app is unaffected. See CODES_RAG.md.

# Embedding model used to build and query the index. Changing it costs you a
# rebuild: the index records the model it was built with, and a manifest that does
# not match this value is refused rather than used, because a mismatched index
# returns confident nonsense. Rebuild with `cd backend && python -m codesearch build`.
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Where you put the code text — one plain .txt or .md per standard.
# CODES_CORPUS_DIR=backend/codes_corpus

# Where the build writes vectors.npy, chunks.json and manifest.json.
# CODES_INDEX_DIR=backend/codes_index

# GEMINI_API_KEY above is what buys semantic search. Without it retrieval still
# works in keyword-only (degraded) mode — exact clause and code lookups are fine,
# paraphrased questions are weaker — and every result is marked degraded.
