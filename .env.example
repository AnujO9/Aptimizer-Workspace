# ---------------------------------------------------------------- database
# Left as-is, docker compose points this at the bundled mongo service.
# For MongoDB Atlas, paste the connection string here instead.
MONGO_URL=mongodb://mongo:27017
DB_NAME=aptimizer

# ---------------------------------------------------------------- security
# Sign-in tokens are signed with this. Generate a fresh one, never reuse an
# example, and never commit the real file:
#   openssl rand -hex 32
JWT_SECRET=

# Created on first startup. Change the password after the first sign-in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------- web
# Only used when the API is served from a different origin than the web app.
# With this compose file they share an origin, so it can stay as-is.
FRONTEND_URL=http://localhost

# Host port the web app is published on. 80 for a server, 8080 if something
# already occupies 80 on your Mac.
WEB_PORT=80

# ---------------------------------------------------------------- HTTPS
# Only needed if you uncomment the caddy service.
DOMAIN=aptimizer.example.com
LETSENCRYPT_EMAIL=you@example.com

# ---------------------------------------------------------------- AI
# At least one is required for APT and the AI reports. Without any, those
# features disable themselves with a reason rather than erroring.
GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# EMERGENT_LLM_KEY=
