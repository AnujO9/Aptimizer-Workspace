{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "D:/Workspace/backend/venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "server:app",
        "--app-dir", "D:/Workspace/backend",
        "--reload",
        "--reload-dir", "D:/Workspace/backend",
        "--host", "127.0.0.1",
        "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "D:/Workspace/frontend", "start"],
      "port": 3000
    }
  ]
}
